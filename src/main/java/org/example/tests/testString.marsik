/*
  Works fine, no issues found so far
*/

string s1 = "racecar"
printLine(s1.isPalindrome())

string s2 = "Hell"
string c = "l"
s2.append(c)
s2.append("o")
printLine(s2)
printLine(s2.stringLength())
printLine(s2.getCharAt(1))
printLine(s2)

string a = "Hello"
string b = " World"
a.append(b)
printLine(a)
a.reverse()
printLine(a)

string nums = "12345"
printLine(nums.hasOnlyDigits())
printLine(nums.hasDigits())

string mixed = "abc123"
printLine(mixed.hasDigits())
printLine(mixed.hasOnlyLetters())

string letters = "abc"
printLine(letters.hasOnlyLetters())

string spaced = "a b c"
printLine(spaced.hasWhiteSpace())
printLine(spaced)

char aaaaa = 'l'
printLine(a.stringIndexOf(aaaaa))
printLine(a.lastIndexOf('l'))
printLine(a.countOccurrence('l'))

a.capitalize()
printLine(a)

printLine(a.stringEquals(b))