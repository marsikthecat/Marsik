/*
  Works fine, no issues found so far
*/

string empty = ""
string text = "Racecar 123"
string lower = "hello world"
string upper = "HELLO WORLD"
string whitespace = "  \t"
string palindromeRacecar = "racecar"
string palindromeA = "A"
string palindromeAb = "ab"
string alphabetInput = "Cabba"
string digitsOnly = "12345"
string digitsMixed = "12a"
string digitsPresent = "a12"
string lettersOnly = "abc"
string lettersMixed = "ab1"
string lettersPresent = "1ab"
string noLetters = "123"
string spaced = "a b"
string noSpace = "abc"
string alphanumeric = "abc123"
string notAlphanumeric = "abc-123"
string vowelsAndConsonants = "aEiOUxyz"
string countedSpaces = "a b  c"
string singleSpace = " "
string mixedSpace = "a "

printLine("equals", String.equals(text, "Racecar 123"), String.equals(text, lower))
printLine("hash", String.hash(text), String.hash(text))
printLine("length", String.length(empty), String.length(text))
printLine("getCharAt", String.getCharAt(text, 0), String.getCharAt(text, String.length(text) - 1))
printLine("index", String.indexOf(text, 'a'), String.indexOf(text, 'z'))
printLine("lastIndex", String.lastIndexOf(text, 'a'), String.lastIndexOf(text, 'z'))
printLine("contains", String.contains(text, 'a'), String.contains(text, 'z'))
printLine("count", String.countOccurrence(text, 'a'), String.countOccurrence(text, 'z'))

printLine("substring", String.substring(text, 0, 4), String.substring(text, 4, 4), String.substring(text, -1, 3), String.substring(text, 3, 2), String.substring(text, 0, 100))
printLine("upper", String.toUpperCase(lower))
printLine("lower", String.toLowerCase(upper))
printLine("starts", String.startsWith(text, "Race"), String.startsWith(text, "race"), String.startsWith(text, ""), String.startsWith(text, "Racecar 1234"))
printLine("ends", String.endsWith(text, "123"), String.endsWith(text, "1234"), String.endsWith(text, ""), String.endsWith(text, "Racecar"))
printLine("palindrome", String.isPalindrome(palindromeRacecar), String.isPalindrome(palindromeA), String.isPalindrome(palindromeAb), String.isPalindrome(empty))
printLine("alphabetIndexes", String.alphabetIndexes(alphabetInput))

printLine("digits", String.hasOnlyDigits(digitsOnly), String.hasOnlyDigits(empty), String.hasOnlyDigits(digitsMixed), String.hasDigits(digitsPresent), String.hasDigits(lettersOnly))
printLine("letters", String.hasOnlyLetters(lettersOnly), String.hasOnlyLetters(empty), String.hasOnlyLetters(lettersMixed), String.hasLetters(lettersPresent), String.hasLetters(noLetters))
printLine("whitespace", String.hasWhiteSpace(whitespace), String.hasWhiteSpace(spaced), String.hasWhiteSpace(noSpace))
printLine("alphanumeric", String.isAlphaNumeric(alphanumeric), String.isAlphaNumeric(notAlphanumeric), String.isAlphaNumeric(empty))
printLine("case", String.isLowercase(lower), String.isLowercase(upper), String.isUppercase(upper), String.isUppercase(lower), String.isLowercase(empty), String.isUppercase(empty))
printLine("onlyWhitespace", String.isWhiteSpace(whitespace), String.isWhiteSpace(singleSpace), String.isWhiteSpace(mixedSpace), String.isWhiteSpace(empty))
printLine("counts", String.numberOfVowels(vowelsAndConsonants), String.numberOfConsonants(vowelsAndConsonants), String.numberOfWhiteSpaces(countedSpaces))

string mutablestr = "hello"
String.setCharAt(mutablestr, 1, 'a')
String.append(mutablestr, " world")
String.reverse(mutablestr)
String.capitalize(mutablestr)
printLine("void methods", mutablestr)
