/*
  Works fine, no issues found so far
*/

string newFileName = "file.txt"
string newFileContent = "Hello World!"
string replacementContent = "Replaced content."
string appendedContent = " Appended content."
string emptyContent = ""

printLine("Exists before create: ", FileHandler.doesFileExist(newFileName))
printLine("Create file: ", FileHandler.createFile(newFileName))
printLine("Create existing file: ", FileHandler.createFile(newFileName))
FileHandler.appendContentToFile(newFileName, newFileContent)
printLine("Wrote content to file: ", newFileName)
printLine("Append content: ", FileHandler.appendContentToFile(newFileName, appendedContent))

if (FileHandler.doesFileExist(newFileName)) {
  printLine("File ", newFileName, "exists")
}
string fileContent = FileHandler.readFile(newFileName)
printLine("Content read from file: ", fileContent)

printLine("Write replacement: ", FileHandler.writeContentToFile(newFileName, replacementContent))
printLine("Replacement read: ", FileHandler.readFile(newFileName))

printLine("Clear file: ", FileHandler.clearFile(newFileName))

string emptyFileContent = FileHandler.readFile(newFileName)

printLine("Content after clearing: ", emptyFileContent)
printLine("Append empty content: ", FileHandler.appendContentToFile(newFileName, emptyContent))

string a = newFileContent
printLine("Write original content: ", FileHandler.writeContentToFile(newFileName, a))
printLine("Original content read: ", FileHandler.readFile(newFileName))

printLine("Delete file: ", FileHandler.deleteFile(newFileName))
printLine("Exists after delete: ", FileHandler.doesFileExist(newFileName))
printLine("Delete missing file: ", FileHandler.deleteFile(newFileName))