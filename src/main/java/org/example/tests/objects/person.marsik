class Person {
  public string name
  public int age
  public string address
  public List<string> hobbies
  public BitSet set

  Constructor(string personName, int personAge) {
    name = personName
    if (personAge < 0) {
      printLine("Age of person cannot be negative")
      personAge = 0
    }
    age = personAge
    address = ""
    hobbies = new List(10)
    set = new BitSet()
}

  int getAge( ) {
    return age
}

  increaseAge( ) {
    age++
}

  setAddress(string newAddress) {
    address = newAddress
}

  printInfo( ) {
    print("Name: ", name, "Age: ", age)
}

  boolean isAdult( ) {
    return age >= 18
}

  function string reverseName(string name) {
    name.reverse()
    return name
}

  addHobby(string hobby) {
    hobbies.add(hobby)
}
}