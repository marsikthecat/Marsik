class Person {
  public string name
  public int age
  public string address
  public List<string> hobbies
  public BitSet set

  Constructor(string personName, int personAge) {
    name = personName
    if (personAge < 0) {
      printLine("Age of person cannot be negative")
      personAge = 0
    }
    age = personAge
    address = ""
    hobbies = new List(10)
    set = new BitSet()
}

  Method: int getAge( ) {
    return age
}

  Method: increaseAge( ) {
    age++
}

  Method: setAddress(string newAddress) {
    address = newAddress
}

  Method: printInfo( ) {
    print("Name: ", name, "Age: ", age)
}

  Method: boolean isAdult( ) {
    return age >= 18
}

  Method: string reverseName( ) {
    string reversedName = name
    name.reverse()
    return reversedName
}

  Method: addHobby(string hobby) {
    hobbies.add(hobby)
}
}