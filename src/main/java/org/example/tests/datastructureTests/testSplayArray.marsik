/*
  Works fine, no issues found so far
*/

SplayArray<int> values = new SplayArray()
values.set(0, 3)
values.set(1, 1)
values.set(2, 2)
print("Length: ", values.length())
print("Value at index 1: ", values.get(1))
print("Index of 2: ", values.indexOf(2))
values.sort()
print("Sorted values: ")
values.printArray()
values.reverse()
print("Reversed values: ")
values.printArray()
print("Most appearing value: ", values.mostAppearingElement())
print("Memory size: ", values.memorySize())
print("Contains 1: ", values.contains(1))
print("Contains missing: ", values.contains(99))
print("Index of missing: ", values.indexOf(99))
print("Is empty: ", values.isEmpty())
print("Random element: ", values.getRandomElement())
values.removeDuplicateOf(2)
values.removeDuplicates()
values.shuffle()
print("After duplicate removal and shuffle: ")
values.printArray()
SplayArray<int> cloned = values.clone()
print("Clone: ")
cloned.printArray()
SplayArray<int> sliced = values.slice(0, 2)
print("Slice: ")
sliced.printArray()
print("Numeric array: ", values.isNumericArray())