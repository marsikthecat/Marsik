/*
  Works fine, no issues found so far
*/

SplayArray<int> values = SplayArray.init()
SplayArray.set(values, 0, 3)
SplayArray.set(values, 1, 1)
SplayArray.set(values, 2, 2)
print("Length: ", SplayArray.length(values))
print("Value at index 1: ", SplayArray.get(values, 1))
print("Index of 2: ", SplayArray.indexOf(values, 2))
SplayArray.sort(values)
print("Sorted values: ")
SplayArray.printArray(values)
SplayArray.reverse(values)
print("Reversed values: ")
SplayArray.printArray(values)
print("Most appearing value: ", SplayArray.mostAppearingElement(values))
print("Memory size: ", SplayArray.memorySize(values))
print("Contains 1: ", SplayArray.contains(values, 1))
print("Contains missing: ", SplayArray.contains(values, 99))
print("Index of missing: ", SplayArray.indexOf(values, 99))
print("Is empty: ", SplayArray.isEmpty(values))
print("Random element: ", SplayArray.getRandomElement(values))
SplayArray.removeDuplicateOf(values, 2)
SplayArray.removeDuplicates(values)
SplayArray.shuffle(values)
print("After duplicate removal and shuffle: ")
SplayArray.printArray(values)
SplayArray<int> cloned = SplayArray.clone(values)
print("Clone: ")
SplayArray.printArray(cloned)
SplayArray<int> sliced = SplayArray.slice(values, 0, 2)
print("Slice: ")
SplayArray.printArray(sliced)
print("Numeric array: ", SplayArray.isNumericArray(values))