/*
  Works fine, no issues found so far
*/

Graph graph = Graph.init()
Node origin = Node.init("origin")
Node destination = Node.init("destination")
Edge route = Edge.init("route")
print("Origin identifier: ", Node.getIdentifier(origin))
print("Route weight initially: ", Edge.getWeight(route))
Edge.setWeight(route, 2.5)
Edge.setDestination(route, destination)
Node.addEdge(origin, route)
Node routeDestination = Edge.getDestination(route)
print("Route destination: ", Node.getIdentifier(routeDestination))
Graph.addNode(graph, origin)
Graph.addNode(graph, destination)
Graph.addNode(graph, origin)
print("Graph contains origin: ", Graph.containsNode(graph, "origin"))
print("Origin contains route: ", Node.containsEdge(origin, "route"))
print("Origin edge count: ", Node.getNumberOfEdges(origin))
print("Route weight: ", Edge.getWeight(route))
print("Graph contains missing node: ", Graph.containsNode(graph, "missing"))
print("Origin contains missing edge: ", Node.containsEdge(origin, "missing"))
Node.removeEdge(origin, route)
Node.removeEdge(origin, route)
Graph.removeNode(graph, destination)
Graph.removeNode(graph, destination)
print("Origin contains route after removal: ", Node.containsEdge(origin, "route"))
print("Graph contains destination after removal: ", Graph.containsNode(graph, "destination"))