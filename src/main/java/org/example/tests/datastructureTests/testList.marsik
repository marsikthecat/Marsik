/*
  Works fine, no issues found so far
*/

List<int> list1 = new List(10)
list1.add(2)
list1.add(3)
list1.add(6)
list1.add(6)
list1.removeDuplicateOf(6)
list1.printList()
print("Size: ", list1.size())
print("Capacity: ", list1.capacity())
print("Contains 2: ", list1.contains(2))
print("Contains missing: ", list1.contains(99))
print("Index of 6: ", list1.indexOf(6))
print("Last index of 6: ", list1.lastIndexOf(6))
print("Get first: ", list1.get(0))
list1.addAt(1, 9)
list1.set(1, 8)
print("After addAt and set: ")
list1.printList()
print("Remove 8: ", list1.remove(8))
list1.removeAt(0)
list1.removeAll(6)
list1.printList()
list1.add(4)
list1.add(4)
print("Most appearing: ", list1.mostAppearingElement())
print("Most appearing count: ", list1.mostAppearingElementCount())
print("Random element: ", list1.randomElement())
list1.sort()
list1.reverse()
list1.trim()
print("Sorted and reversed: ")
list1.printList()
List<int> withoutDuplicates = list1.withoutDuplicates()
print("Without duplicates: ")
withoutDuplicates.printList()
List<int> cloned = list1.clone()
print("Clone: ")
cloned.printList()
list1.clear()
print("Empty after clear: ", list1.isEmpty())
list1.resize(2)
print("Capacity after resize: ", list1.capacity())