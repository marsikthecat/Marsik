/*
  Works fine, no issues found so far
*/

List<int> list1 = List.init(10)
List.add(list1, 2)
List.add(list1, 3)
List.add(list1, 6)
List.add(list1, 6)
List.removeDuplicates(list1)
List.printList(list1)
print("Size: ", List.size(list1))
print("Capacity: ", List.capacity(list1))
print("Contains 2: ", List.contains(list1, 2))
print("Contains missing: ", List.contains(list1, 99))
print("Index of 6: ", List.indexOf(list1, 6))
print("Last index of 6: ", List.lastIndexOf(list1, 6))
print("Get first: ", List.get(list1, 0))
List.addAt(list1, 1, 9)
List.set(list1, 1, 8)
print("After addAt and set: ")
List.printList(list1)
print("Remove 8: ", List.remove(list1, 8))
List.removeAt(list1, 0)
List.removeAll(list1, 6)
List.printList(list1)
List.add(list1, 6)
List.add(list1, 6)
List.removeDuplicateOf(list1, 6)
print("After removing duplicate 6: ")
List.printList(list1)
List.add(list1, 4)
List.add(list1, 4)
print("Most appearing: ", List.mostAppearingElement(list1))
print("Most appearing count: ", List.mostAppearingElementCount(list1))
print("Random element: ", List.randomElement(list1))
List.sort(list1)
List.reverse(list1)
List.trim(list1)
print("Sorted and reversed: ")
List.printList(list1)
List<int> withoutDuplicates = List.withoutDuplicates(list1)
print("Without duplicates: ")
List.printList(withoutDuplicates)
List<int> cloned = List.clone(list1)
print("Clone: ")
List.printList(cloned)
List.clear(list1)
print("Empty after clear: ", List.isEmpty(list1))
List.resize(list1, 2)
print("Capacity after resize: ", List.capacity(list1))