/*
  Works fine, no issues found so far
*/

BinaryTree<int> tree = BinaryTree.init()
print("Empty height: ", BinaryTree.height(tree))
BinaryTree.inorder(tree)
BinaryTree.preorder(tree)
BinaryTree.postorder(tree)
BinaryTree.levelorder(tree)

BinaryTree.insert(tree, 8)
BinaryTree.insert(tree, 3)
BinaryTree.insert(tree, 10)
BinaryTree.insert(tree, 1)
BinaryTree.insert(tree, 6)
BinaryTree.insert(tree, 14)
BinaryTree.insert(tree, 4)
BinaryTree.insert(tree, 7)
BinaryTree.insert(tree, 13)
BinaryTree.insert(tree, 6)

print("Height after inserts: ", BinaryTree.height(tree))
TreeNode<int> rootNode = BinaryTree.search(tree, 8)
TreeNode<int> leafNode = BinaryTree.search(tree, 1)
print("Search root: ", TreeNode.getData(rootNode))
print("Search leaf: ", TreeNode.getData(leafNode))
print("Inorder: ")
BinaryTree.inorder(tree)
print("Preorder: ")
BinaryTree.preorder(tree)
print("Postorder: ")
BinaryTree.postorder(tree)
print("Levelorder: ")
BinaryTree.levelorder(tree)

BinaryTree.remove(tree, 1)
print("After removing leaf: ")
BinaryTree.inorder(tree)
BinaryTree.remove(tree, 14)
print("After removing one-child node: ")
BinaryTree.inorder(tree)
BinaryTree.remove(tree, 3)
print("After removing two-child node: ")
BinaryTree.inorder(tree)
BinaryTree.remove(tree, 99)
print("After removing missing value: ")
BinaryTree.inorder(tree)
