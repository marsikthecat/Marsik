/*
  Works fine, no issues found so far
*/

BinaryTree<int> tree = new BinaryTree()
print("Empty height: ", tree.height())
tree.inorder()
tree.preorder()
tree.postorder()
tree.levelorder()

tree.insert(8)
tree.insert(3)
tree.insert(10)
tree.insert(1)
tree.insert(6)
tree.insert(14)
tree.insert(4)
tree.insert(7)
tree.insert(13)
tree.insert(6)

print("Height after inserts: ", tree.height())
TreeNode<int> rootNode = tree.search(8)
TreeNode<int> leafNode = tree.search(1)
print("Search root: ", rootNode.getData())
print("Search leaf: ", leafNode.getData())
print("Inorder: ")
tree.inorder()
print("Preorder: ")
tree.preorder()
print("Postorder: ")
tree.postorder()
print("Levelorder: ")
tree.levelorder()

tree.remove(1)
print("After removing leaf: ")
tree.inorder()
tree.remove(14)
print("After removing one-child node: ")
tree.inorder()
tree.remove(3)
print("After removing two-child node: ")
tree.inorder()
tree.remove(99)
print("After removing missing value: ")
tree.inorder()
