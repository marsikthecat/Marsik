/*
  Works fine, no issues found so far
*/

BitSet bits = BitSet.init()
print("Initially empty: ", BitSet.isEmpty(bits))
BitSet.set(bits, 0)
BitSet.set(bits, 3)
print("Bit 0: ", BitSet.get(bits, 0))
print("Bit 3: ", BitSet.get(bits, 3))
print("Set bits: ", BitSet.count(bits))
BitSet.toggle(bits, 3)
print("After toggling bit 3: ", BitSet.get(bits, 3))
BitSet.setAll(bits)
print("Full after setAll: ", BitSet.isFull(bits))
BitSet.clearAll(bits)
print("Empty after clearAll: ", BitSet.isEmpty(bits))
print("Full after clearAll: ", BitSet.isFull(bits))
print("Count after clearAll: ", BitSet.count(bits))
BitSet.clear(bits, 7)
BitSet.toggle(bits, 7)
print("Bit 7 after toggle: ", BitSet.get(bits, 7))
BitSet.setAll(bits)
print("Count after second setAll: ", BitSet.count(bits))
print("Full after second setAll: ", BitSet.isFull(bits))
BitSet.toggle(bits, 0)
print("Full after clearing one bit: ", BitSet.isFull(bits))