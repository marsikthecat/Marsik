/*
  Works fine, no issues found so far
*/

Matrix matrix = Matrix.init(3, 3)
int[9] values = [1,2,3,4,5,6,7,8,9]
Matrix.fill(matrix, values)
printLine("Number of Rows:", Matrix.numberOfRows(matrix))
printLine("Number of Columns:", Matrix.numberOfColumns(matrix))
printLine("Sum of Matrix:", Matrix.sum(matrix))
printLine("Get center:", Matrix.get(matrix, 1, 1))
Matrix.set(matrix, 1, 1, 99)
printLine("Set center:", Matrix.get(matrix, 1, 1))
printLine("Determinant:", Matrix.getDeterminant(matrix))
printLine("Invertible:", Matrix.isInvertible(matrix))
printLine("Trace:", Matrix.trace(matrix))
printLine("Normal:", Matrix.normal(matrix))
Matrix transpose = Matrix.transpose(matrix)
printLine("Transpose rows:", Matrix.numberOfRows(transpose))
printLine("Transpose columns:", Matrix.numberOfColumns(transpose))
Matrix clone = Matrix.clone(matrix)
printLine("Clone sum:", Matrix.sum(clone))
Matrix added = Matrix.add(matrix, clone)
printLine("Added center:", Matrix.get(added, 1, 1))
Matrix multiplied = Matrix.multiply(matrix, clone)
printLine("Multiplied center:", Matrix.get(multiplied, 1, 1))
Matrix.printMatrix(matrix)
