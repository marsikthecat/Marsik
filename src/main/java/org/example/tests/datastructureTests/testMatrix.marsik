/*
  Works fine, no issues found so far
*/

Matrix matrix = new Matrix(3, 3)
int[9] values = [1,2,3,4,5,6,7,8,9]
matrix.fill(values)
printLine("Number of Rows:", matrix.numberOfRows())
printLine("Number of Columns:", matrix.numberOfColumns())
printLine("Sum of Matrix:", matrix.sum())
printLine("Get center:", matrix.get(1, 1))
matrix.set(1, 1, 99)
printLine("Set center:", matrix.get(1, 1))
printLine("Determinant:", matrix.getDeterminant())
printLine("Invertible:", matrix.isInvertible())
printLine("Trace:", matrix.trace())
printLine("Normal:", matrix.normal())
Matrix transpose = matrix.transpose()
printLine("Transpose rows:", transpose.numberOfRows())
printLine("Transpose columns:", transpose.numberOfColumns())
Matrix clone = matrix.clone()
printLine("Clone sum:", clone.sum())
Matrix added = matrix.add(clone)
printLine("Added center:", added.get(1, 1))
Matrix multiplied = matrix.multiply(clone)
printLine("Multiplied center:", multiplied.get(1, 1))
matrix.print()

