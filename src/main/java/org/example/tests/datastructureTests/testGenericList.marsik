/*
  Works fine, no issues found so far
*/

GenericList values = GenericList.init()
GenericList.addInt(values, 4)
GenericList.addDouble(values, 2.5)
GenericList.addString(values, "Marsik")
GenericList.addFloat(values, 1.5)
GenericList.addChar(values, 'x')
GenericList.addBool(values, true)
print("Size: ", GenericList.size(values))
print("Type at index 0: ", GenericList.getType(values, 0))
print("Type at index 1: ", GenericList.getType(values, 1))
print("Type at index 2: ", GenericList.getType(values, 2))
print("All same type: ", GenericList.allSameType(values))
print("All numeric: ", GenericList.allNumeric(values))
print("All strings: ", GenericList.allStrings(values))
GenericList.remove(values, 1)
print("Size after remove: ", GenericList.size(values))
GenericList.clear(values)
print("Empty after clear: ", GenericList.isEmpty(values))
print("All numeric when empty: ", GenericList.allNumeric(values))