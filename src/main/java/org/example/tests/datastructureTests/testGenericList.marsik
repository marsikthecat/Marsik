/*
  Works fine, no issues found so far
*/

GenericList values = new GenericList()
values.addInt(4)
values.addDouble(2.5)
values.addString("Marsik")
values.addFloat(1.5)
values.addChar('x')
values.addBool(true)
print("Size: ", values.size())
print("Type at index 0: ", values.getType(0))
print("Type at index 1: ", values.getType(1))
print("Type at index 2: ", values.getType(2))
print("All same type: ", values.allSameType())
print("All numeric: ", values.allNumeric())
print("All strings: ", values.allStrings())
values.remove(1)
print("Size after remove: ", values.size())
values.clear()
print("Empty after clear: ", values.isEmpty())
print("All numeric when empty: ", values.allNumeric())