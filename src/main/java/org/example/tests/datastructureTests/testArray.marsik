/*
  Works fine, no issues found so far
*/

int[5] intArray = [1,2,3,4,5]
print("Here I have an Array: ")
intArray.printArray()
int a = scan("Type in an integer:")
boolean b = intArray.contains(a)
if (b) {
  print("Array contains ", a)
} else {
  print("Array does not contain ", a)
}

print("Here another Array of chars: ")
char[2] arr = ['a','b']
arr.printArray()
arr.set(1,'c')
print("Array after setting b to c: ")
arr.printArray()
print("First Element of Array", arr.get(0))
print("Does it contain the letter c? ", arr.contains('c'))