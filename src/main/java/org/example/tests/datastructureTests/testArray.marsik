/*
  Works fine, no issues found so far
*/

int[5] intArray = [1,2,3,-4,5]
print("Here another Array of chars: ")
char[2] arr = ['a','b']
Array.printArray(arr)
Array.set(arr, 1, 'c')
print("Array after setting b to c: ")
Array.printArray(arr)
print("First Element of Array", Array.get(arr, 0))
print("Does it contain the letter c? ", Array.contains(arr, 'c'))

print("Integer array length: ", Array.length(intArray))
print("Integer array memory: ", Array.memorySize(intArray))
print("Integer array index of 3: ", Array.indexOf(intArray, 3))
print("Integer array index of missing: ", Array.indexOf(intArray, 99))
print("Integer array get last: ", Array.get(intArray, 4))
print("Integer array is empty: ", Array.isEmpty(intArray))
print("Integer array random element: ", Array.getRandomElement(intArray))
print("Integer array numeric: ", Array.isNumericArray(intArray))
int[2] slicedArray = Array.slice(intArray, 1, 3)
print("Array slice: ")
Array.printArray(slicedArray)
int[3] orderedArray = [3,1,3]
Array.sort(orderedArray)
Array.reverse(orderedArray)
print("After sort and reverse: ")
Array.printArray(orderedArray)
int[2] clonedArray = Array.clone(orderedArray)
print("Cloned array: ")
Array.printArray(clonedArray)
print("Most appearing value: ", Array.mostAppearingElement(intArray))
Array.shuffle(intArray)
print("After shuffle: ")
Array.printArray(intArray)