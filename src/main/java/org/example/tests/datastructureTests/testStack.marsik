/*
  Works fine, no issues found so far
*/

Stack<int> stack = Stack.init()
print("Initially empty: ", Stack.isEmpty(stack))
print("Initially full: ", Stack.isFull(stack))
print("Initial size: ", Stack.size(stack))
Stack.push(stack, 10)
Stack.push(stack, 20)
print("Top: ", Stack.peek(stack))
print("Pop 1: ", Stack.pop(stack))
print("Pop 2: ", Stack.pop(stack))
print("Empty after pops: ", Stack.isEmpty(stack))
print("Size: ", Stack.size(stack))
print("Peek empty: ", Stack.peek(stack))
print("Pop empty: ", Stack.pop(stack))