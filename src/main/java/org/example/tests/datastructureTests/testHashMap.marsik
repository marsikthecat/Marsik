/*
  Works fine, no issues found so far
*/

HashMap<int, int> numbers = HashMap.init(4)
HashMap.put(numbers, 1, 10)
HashMap.put(numbers, 5, 50)
print("Value for key 1: ", HashMap.get(numbers, 1))
print("Value for colliding key 5: ", HashMap.get(numbers, 5))
print("Contains key 1: ", HashMap.containsKey(numbers, 1))
print("Missing key value: ", HashMap.get(numbers, 99))
print("Contains missing key: ", HashMap.containsKey(numbers, 99))
print("Size: ", HashMap.size(numbers))
print("Capacity: ", HashMap.capacity(numbers))
HashMap.put(numbers, 1, 100)
print("Updated value for key 1: ", HashMap.get(numbers, 1))
HashMap.remove(numbers, 1)
print("Contains key 1 after removal: ", HashMap.containsKey(numbers, 1))
HashMap.clear(numbers)
print("Empty after clear: ", HashMap.isEmpty(numbers))
print("Size after clear: ", HashMap.size(numbers))