/*
  Works fine, no issues found so far
*/

SparseArray<int> values = SparseArray.init(4)
SparseArray.set(values, 0, 10)
SparseArray.set(values, 3, 30)
SparseArray.set(values, 6, 60)
print("Size: ", SparseArray.size(values))
print("Max index: ", SparseArray.maxIndex(values))
print("Hole count: ", SparseArray.holeCount(values))
print("Value at index 3: ", SparseArray.get(values, 3))
print("Has index 3: ", SparseArray.has(values, 3))
print("Has hole at index 2: ", SparseArray.has(values, 2))
print("Contains 60: ", SparseArray.contains(values, 60))
print("Index of 30: ", SparseArray.indexOf(values, 30))
print("Missing index: ", SparseArray.indexOf(values, 99))

SparseArray.remove(values, 3)
print("Hole count after remove: ", SparseArray.holeCount(values))
SparseArray.set(values, 3, 35)
print("Hole count after filling: ", SparseArray.holeCount(values))
print("Updated value at index 3: ", SparseArray.get(values, 3))

SparseArray.pushfromStart(values, 5)
SparseArray.pushfromEnd(values, 70)
print("After pushing values: ")
SparseArray.printArray(values)
int[4] compactValues = SparseArray.toArray(values)
print("Array size: ", Array.length(compactValues))
print("Random element: ", SparseArray.getRandomElement(values))

SparseArray.clear(values)
print("Empty after clear: ", SparseArray.isEmpty(values))