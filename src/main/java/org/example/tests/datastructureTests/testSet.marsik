/*
  Works fine, no issues found so far
*/

Set<int> values = Set.init(4)
print("Capacity: ", Set.capacity(values))
print("Initially empty: ", Set.isEmpty(values))
print("Add 7: ", Set.add(values, 7))
print("Add duplicate 7: ", Set.add(values, 7))
Set.add(values, 3)
print("Contains 7: ", Set.contains(values, 7))
print("Size: ", Set.size(values))
Set.remove(values, 7)
print("Contains 7 after removal: ", Set.contains(values, 7))
print("Remove missing value: ", Set.remove(values, 99))
Set.clear(values)
print("Empty after clear: ", Set.isEmpty(values))
print("Size after clear: ", Set.size(values))