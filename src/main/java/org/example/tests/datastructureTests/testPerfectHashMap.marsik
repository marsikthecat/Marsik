/*
  Works fine, no issues found so far
*/

PerfectHashMap<int> values = PerfectHashMap.init(16)
print("Capacity: ", PerfectHashMap.capacity(values))
print("Define answer: ", PerfectHashMap.defineKey(values, "answer"))
print("Define duplicate answer: ", PerfectHashMap.defineKey(values, "answer"))
print("Define year: ", PerfectHashMap.defineKey(values, "year"))
PerfectHashMap.put(values, "answer", 42)
PerfectHashMap.put(values, "year", 2026)
print("Answer: ", PerfectHashMap.get(values, "answer"))
print("Year: ", PerfectHashMap.get(values, "year"))
print("Contains answer: ", PerfectHashMap.containsKey(values, "answer"))
print("Missing key value: ", PerfectHashMap.get(values, "missing"))
print("Contains missing key: ", PerfectHashMap.containsKey(values, "missing"))
print("Size: ", PerfectHashMap.size(values))
PerfectHashMap.remove(values, "answer")
print("Contains answer after removal: ", PerfectHashMap.containsKey(values, "answer"))
PerfectHashMap.clear(values)
print("Empty after clear: ", PerfectHashMap.isEmpty(values))
print("Size after clear: ", PerfectHashMap.size(values))