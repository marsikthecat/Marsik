/*
  Works fine, no issues found so far
*/

PerfectHashMap<int> values = new PerfectHashMap(16)
print("Capacity: ", values.capacity())
print("Define answer: ", values.defineKey("answer"))
print("Define duplicate answer: ", values.defineKey("answer"))
print("Define year: ", values.defineKey("year"))
values.put("answer", 42)
values.put("year", 2026)
print("Answer: ", values.get("answer"))
print("Year: ", values.get("year"))
print("Contains answer: ", values.containsKey("answer"))
print("Missing key value: ", values.get("missing"))
print("Contains missing key: ", values.containsKey("missing"))
print("Size: ", values.size())
values.remove("answer")
print("Contains answer after removal: ", values.containsKey("answer"))
values.clear()
print("Empty after clear: ", values.isEmpty())
print("Size after clear: ", values.size())