/*
  Works fine, no issues found so far
*/

Queue<int> queue = Queue.init()
print("Initially empty: ", Queue.isEmpty(queue))
print("Initially full: ", Queue.isFull(queue))
print("Initial size: ", Queue.size(queue))
Queue.enqueue(queue, 10)
Queue.enqueue(queue, 20)
print("Front: ", Queue.peek(queue))
print("Dequeue 1: ", Queue.dequeue(queue))
print("Dequeue 2: ", Queue.dequeue(queue))
print("Empty after dequeues: ", Queue.isEmpty(queue))
print("Size: ", Queue.size(queue))
print("Peek empty: ", Queue.peek(queue))
print("Dequeue empty: ", Queue.dequeue(queue))