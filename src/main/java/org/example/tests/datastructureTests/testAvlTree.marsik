/*
  Works fine, no issues found so far
*/

AvlTree<int> tree = AvlTree.init()
print("Empty height: ", AvlTree.height(tree))
print("Contains missing: ", AvlTree.contains(tree, 99))
AvlTree.inorder(tree)
AvlTree.preorder(tree)
AvlTree.postorder(tree)

AvlTree.insert(tree, 30)
AvlTree.insert(tree, 20)
AvlTree.insert(tree, 10)
print("After right rotation height: ", AvlTree.height(tree))
print("Contains 20: ", AvlTree.contains(tree, 20))
print("Contains missing: ", AvlTree.contains(tree, 99))

AvlTree.insert(tree, 25)
AvlTree.insert(tree, 28)
AvlTree.insert(tree, 40)
AvlTree.insert(tree, 50)
AvlTree.insert(tree, 5)
AvlTree.insert(tree, 20)

print("Height after rotations: ", AvlTree.height(tree))
print("Inorder: ")
AvlTree.inorder(tree)
print("Preorder: ")
AvlTree.preorder(tree)
print("Postorder: ")
AvlTree.postorder(tree)

AvlTree.delete(tree, 5)
print("After deleting leaf: ", AvlTree.height(tree))
AvlTree.delete(tree, 40)
print("After deleting one-child node: ", AvlTree.height(tree))
AvlTree.delete(tree, 20)
print("After deleting node with children: ", AvlTree.height(tree))
AvlTree.delete(tree, 99)
print("After deleting missing value: ", AvlTree.height(tree))
print("Contains deleted value: ", AvlTree.contains(tree, 20))
